# --- choose providers (defaults run fully offline) ---
RAG_LLM__PROVIDER=mock            # mock | openai | azure_openai
RAG_LLM__MODEL=gpt-4o-mini        # or your Azure deployment name
RAG_EMBEDDINGS__PROVIDER=hashing  # hashing | openai | azure_openai
RAG_EMBEDDINGS__MODEL=text-embedding-3-large

# --- OpenAI ---
OPENAI_API_KEY=

# --- Azure OpenAI (recommended for UAE data residency: UAE North region) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
